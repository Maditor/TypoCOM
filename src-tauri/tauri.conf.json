{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypoCOM",
  "version": "0.1.0",
  "identifier": "com.typocore.cs6",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TypoCOM",
        "width": 480,
        "height": 820,
        "minWidth": 200,
        "minHeight": 200,
        "resizable": true,
        "alwaysOnTop": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
